---
import { ArrowLeft, ArrowRight, ArrowUpRight, Check, Star } from "lucide-react";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { UtilityBar } from "@/components/UtilityBar";
import { SiteFooter } from "@/components/ContactHeaderAndLinks";
import { ProjectMediaView } from "@/components/ProjectsBento";
import { Badge } from "@/components/ui/badge";
import { translations, type Lang } from "@/data/i18n";
import { PROJECTS, type ProjectItem } from "@/data/projects";
import { fetchReleasesAtBuild, fetchRepoStarsAtBuild } from "@/lib/github";
import { setSSRLang } from "@/lib/store";
import { withBase } from "@/lib/utils";

interface Props {
  lang: Lang;
  project: ProjectItem;
}

const { lang, project } = Astro.props;
setSSRLang(lang);
const t = translations[lang];
const otherLang: Lang = lang === "ru" ? "en" : "ru";

const prefix = (l: Lang) => (l === "en" ? "en/" : "");
const path = `projects/${project.id}/`;
const homeHref = withBase(`${prefix(lang)}#projects`);
const altHref = withBase(`${prefix(otherLang)}${path}`);

const repos = PROJECTS.map((p) => p.repoName).filter((r): r is string => Boolean(r));
const [stars, releases] = await Promise.all([
  fetchRepoStarsAtBuild(repos),
  project.repoName ? fetchReleasesAtBuild(project.repoName) : Promise.resolve([]),
]);
const starCount = project.repoName ? stars[project.repoName] ?? 0 : 0;

const idx = PROJECTS.findIndex((p) => p.id === project.id);
const next = PROJECTS[(idx + 1) % PROJECTS.length];
const nextHref = withBase(`${prefix(lang)}projects/${next.id}/`);

const dateFmt = new Intl.DateTimeFormat(lang === "en" ? "en-GB" : "ru-RU", {
  day: "numeric",
  month: "long",
  year: "numeric",
});
const builtAt = new Date().toISOString();

const title = `${project.title} — ${project.badge[lang]} | diorhc`;
const description = project.summary[lang];
const schema = [
  {
    "@type": project.repoName ? "SoftwareSourceCode" : "SoftwareApplication",
    name: project.title,
    description,
    url: `https://diorhc.github.io/diorhc/${prefix(lang)}${path}`,
    author: { "@type": "Person", name: "Dior E (diorhc)" },
    ...(project.repoName
      ? {
          codeRepository: `https://github.com/diorhc/${project.repoName}`,
          programmingLanguage: project.tech[0],
        }
      : { applicationCategory: "CommunicationApplication" }),
  },
];
---

<BaseLayout lang={lang} path={path} title={title} description={description} schema={schema}>
  <UtilityBar client:load altHref={altHref} />

  <main id="main-content" class="mx-auto w-full max-w-[920px] px-5 pb-20 pt-20 sm:px-7 sm:pt-24">
    <a
      href={homeHref}
      class="group mb-8 inline-flex items-center gap-1.5 font-mono-code text-xs text-[var(--text-secondary)] transition-colors hover:text-[var(--accent)]"
    >
      <ArrowLeft className="h-3.5 w-3.5 transition-transform group-hover:-translate-x-0.5" />
      {t.projects.back}
    </a>

    <header class="mb-8">
      <div class="mb-4 flex flex-wrap items-center gap-2">
        <Badge>{project.badge[lang]}</Badge>
        {
          starCount > 0 && (
            <span class="inline-flex items-center gap-1 rounded-full border border-[var(--border-subtle)] px-2.5 py-0.5 font-mono-code text-[11px] text-[var(--text-secondary)]">
              <Star className="h-3 w-3 fill-[var(--accent)] text-[var(--accent)]" aria-hidden="true" />
              {starCount} {t.projects.starsLabel}
            </span>
          )
        }
      </div>
      <h1 class="font-display mb-3 text-4xl font-bold tracking-[-0.03em] sm:text-5xl">
        {project.title}
      </h1>
      <p class="max-w-2xl text-base text-[var(--text-secondary)] sm:text-lg">{description}</p>

      <div class="mt-6 flex flex-wrap gap-2.5">
        {
          project.links.map((link) => (
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              class:list={[
                "inline-flex h-10 items-center gap-1.5 rounded-lg px-4 text-sm font-semibold transition-transform hover:-translate-y-0.5 active:translate-y-0 active:scale-[0.98]",
                link.variant === "secondary"
                  ? "border border-[var(--border-strong)] text-[var(--text-primary)] hover:border-[var(--accent-border)]"
                  : "bg-[var(--accent)] text-[var(--accent-fg)]",
              ]}
            >
              {link.label[lang]}
              <ArrowUpRight className="h-4 w-4" aria-hidden="true" />
            </a>
          ))
        }
      </div>
    </header>

    <div
      aria-hidden="true"
      class="group relative mb-12 h-[220px] overflow-hidden rounded-2xl border border-[var(--border-subtle)] bg-[var(--bg-base)] shadow-[var(--shadow-sm)] sm:h-[340px]"
    >
      <ProjectMediaView media={project.media} lang={lang} />
    </div>

    <div class="grid gap-10 md:grid-cols-[minmax(0,1.5fr)_minmax(0,1fr)]">
      <section aria-labelledby="features-title">
        <h2 id="features-title" class="font-display mb-4 text-xl font-bold tracking-tight">
          {t.projects.keyFeatures}
        </h2>
        <ul class="space-y-3">
          {
            project.features[lang].map((feature) => (
              <li class="flex gap-3 text-[15px] text-[var(--text-secondary)]">
                <span class="mt-0.5 inline-flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-[var(--accent-soft)] text-[var(--accent)]">
                  <Check className="h-3 w-3" aria-hidden="true" />
                </span>
                {feature}
              </li>
            ))
          }
        </ul>
      </section>

      <section aria-labelledby="stack-title">
        <h2 id="stack-title" class="font-display mb-4 text-xl font-bold tracking-tight">
          {t.projects.stack}
        </h2>
        <ul class="flex flex-wrap gap-2">
          {
            project.tech.map((tech) => (
              <li class="rounded-full border border-[var(--border-subtle)] px-3 py-1 font-mono-code text-xs text-[var(--text-secondary)]">
                {tech}
              </li>
            ))
          }
        </ul>
      </section>
    </div>

    {
      releases.length > 0 && (
        <section aria-labelledby="releases-title" class="mt-14">
          <h2 id="releases-title" class="font-display mb-4 text-xl font-bold tracking-tight">
            {t.projects.releases}
          </h2>
          <ol class="divide-y divide-[var(--border-subtle)] rounded-2xl border border-[var(--border-subtle)] bg-[var(--bg-elevated)]">
            {releases.map((release) => (
              <li>
                <a
                  href={release.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group flex flex-col gap-1 px-5 py-4 transition-colors hover:bg-[var(--accent-soft)] sm:flex-row sm:items-baseline sm:gap-5"
                >
                  <span class="shrink-0 font-mono-code text-sm font-semibold text-[var(--accent)] sm:w-24">
                    {release.tag}
                  </span>
                  <span class="min-w-0 flex-1">
                    <span class="block text-sm font-medium text-[var(--text-primary)]">
                      {release.name}
                    </span>
                    {release.summary && (
                      <span class="mt-0.5 block text-[13px] text-[var(--text-secondary)]">
                        {release.summary}
                      </span>
                    )}
                  </span>
                  <time
                    datetime={release.publishedAt}
                    class="shrink-0 font-mono-code text-[11px] text-[var(--text-muted)]"
                  >
                    {dateFmt.format(new Date(release.publishedAt))}
                  </time>
                </a>
              </li>
            ))}
          </ol>
          <a
            href={`https://github.com/diorhc/${project.repoName}/releases`}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-3 inline-flex items-center gap-1 font-mono-code text-xs text-[var(--text-secondary)] underline decoration-[var(--border-strong)] underline-offset-4 transition-colors hover:text-[var(--accent)] hover:decoration-[var(--accent)]"
          >
            {t.projects.allReleases}
            <ArrowUpRight className="h-3 w-3" aria-hidden="true" />
          </a>
        </section>
      )
    }

    <a
      href={nextHref}
      class="group mt-14 flex items-center justify-between gap-4 rounded-2xl border border-[var(--border-subtle)] bg-[var(--bg-elevated)] px-6 py-5 transition-all hover:-translate-y-0.5 hover:border-[var(--accent-border)]"
    >
      <span>
        <span class="block font-mono-code text-[11px] uppercase tracking-wider text-[var(--text-muted)]">
          {t.projects.nextProject}
        </span>
        <span class="font-display text-xl font-bold tracking-tight">{next.title}</span>
      </span>
      <ArrowRight className="h-5 w-5 text-[var(--text-secondary)] transition-transform group-hover:translate-x-1 group-hover:text-[var(--accent)]" />
    </a>
  </main>

  <SiteFooter builtAt={builtAt} />
</BaseLayout>
